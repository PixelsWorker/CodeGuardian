 Changed Files List (Use [↑/↓] or [j/k] to preview diff hunks):

  ▶ src/demo.ts +12 -4
    src/auth/token.ts +48 -12
    src/auth/session.ts +34 -8
    src/db/redis.ts +18 -2
    package.json +3 -1


 ╭────────────────────────────────────────────────────────────────────────────────────────────────╮
 │ src/demo.ts                                                                             +12 -4 │
 │                                                                                                │
 │ @@ -14,6 +14,14 @@ export function resolveUserPermissions(header?: string) {                   │
 │ -  const token = parseToken(header);                                                           │
 │ -  return lookupPermissions(token.sub);                                                        │
 │ +  const token = parseToken(header);                                                           │
 │ +  // BUG: token may be null if header is malformed!                                           │
 │ +  const permissions = lookupPermissions(token.sub);                                           │
 │ +  if (!permissions) {                                                                         │
 │ +    return [];                                                                                │
 │ +  }                                                                                           │
 │ +  return permissions;                                                                         │
 │  }                                                                                             │
 ╰────────────────────────────────────────────────────────────────────────────────────────────────╯


